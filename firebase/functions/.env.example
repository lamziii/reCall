# Copy this file to `.env` (in this same firebase/functions directory) and fill in your key.
# firebase/functions/.env is git-ignored and loaded automatically by the Firebase emulator and
# runtime — no Secret Manager or Blaze plan needed for local development.
#
# The Anthropic API key is a SERVER-ONLY secret. Never put it in the frontend, in any VITE_
# variable, in Firestore, or in git.

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Transcription providers (SERVER-ONLY keys; never a VITE_ var, never in git) ---------------
# Recall's transcription layer is provider-agnostic (firebase/functions/src/transcription/). The
# provider used for real sessions is chosen here; the benchmark tool runs whichever keys are set.
#
# TRANSCRIPTION_PROVIDER picks the provider transcribeSession uses (default openai). Set to
# speechmatics for speaker diarization ("who said what").
TRANSCRIPTION_PROVIDER=openai

# OpenAI — multilingual STT (English/Albanian/mixed). Primary model gpt-4o-transcribe-diarize
# gives speaker-labeled segments with timestamps; on failure it falls back to gpt-4o-transcribe
# (plain text + vocabulary bias). Used by transcribeSession + the benchmark tool. Switch models
# with env only — NO code change needed.
OPENAI_API_KEY=your_openai_api_key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIPTION_FALLBACK_MODEL=gpt-4o-transcribe
# (Legacy aliases OPENAI_TRANSCRIBE_MODEL / OPENAI_TRANSCRIBE_FALLBACK_MODEL are also accepted.)

# Speechmatics (batch) — Albanian ("sq") + speaker diarization + custom vocabulary. The diarizing
# provider. Optional region/base-url override via SPEECHMATICS_URL.
SPEECHMATICS_API_KEY=your_speechmatics_api_key
# SPEECHMATICS_URL=https://asr.api.speechmatics.com/v2

# Optional guardrails (defaults shown): max upload size, max duration, per-request timeout.
# MAX_AUDIO_BYTES=26214400
# MAX_AUDIO_DURATION_SECONDS=5400
# TRANSCRIPTION_REQUEST_TIMEOUT_MS=60000
