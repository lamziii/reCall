// Firestore Security Rules for Recall.
// Cloud Storage access control lives in a separate file: firebase/storage.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if user is a member of a workspace
    function isWorkspaceMember(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // Helper: check if user is an owner of a workspace
    function isWorkspaceOwner(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    // ========================================================================
    // users — the canonical per-account profile (users/{uid})
    // ========================================================================
    // A user can only ever read or write their OWN profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================================================
    // workspaces
    // ========================================================================
    // Members can read their workspace; only the owner can update/delete;
    // any signed-in user can create a workspace (auto-enroll as owner via trigger).
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if request.auth != null && request.auth.uid != null;
      allow update, delete: if isWorkspaceOwner(workspaceId);

      // ====================================================================
      // workspaces/{workspaceId}/members
      // ====================================================================
      // Members can see the roster; only the owner can invite/remove/change roles.
      // Exception: the workspace's own owner may self-enroll as the 'owner' member — this lets
      // the client finish workspace bootstrap without racing the onWorkspaceCreated trigger.
      // It is narrow: only the owner_id user, only into their own workspace, only role 'owner'.
      match /members/{userId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId)
          || (request.auth.uid == userId
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.owner_id == request.auth.uid
              && request.resource.data.role == 'owner');
        allow update, delete: if isWorkspaceOwner(workspaceId);
      }
    }

    // ========================================================================
    // sessions
    // ========================================================================
    // Members of the parent workspace can CRUD.
    match /sessions/{sessionId} {
      allow read: if isWorkspaceMember(resource.data.workspace_id);
      allow create: if isWorkspaceMember(request.resource.data.workspace_id);
      allow update, delete: if isWorkspaceMember(resource.data.workspace_id);
    }

    // ========================================================================
    // session_reviews
    // ========================================================================
    // Document ID is the session ID (see FIREBASE_SCHEMA.md), so {sessionId} here doubles as
    // both the wildcard and the lookup key into sessions/ for the parent workspace check.
    match /session_reviews/{sessionId} {
      allow read, create, update, delete: if isWorkspaceMember(
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.workspace_id
      );
    }

    // ========================================================================
    // documents
    // ========================================================================
    // Members of the workspace can CRUD.
    match /documents/{documentId} {
      allow read: if isWorkspaceMember(resource.data.workspace_id);
      allow create: if isWorkspaceMember(request.resource.data.workspace_id);
      allow update, delete: if isWorkspaceMember(resource.data.workspace_id);
    }

    // ========================================================================
    // projects
    // ========================================================================
    // Members of the workspace can CRUD.
    match /projects/{projectId} {
      allow read: if isWorkspaceMember(resource.data.workspace_id);
      allow create: if isWorkspaceMember(request.resource.data.workspace_id);
      allow update, delete: if isWorkspaceMember(resource.data.workspace_id);
    }

    // ========================================================================
    // tasks
    // ========================================================================
    // Members of the workspace can CRUD.
    match /tasks/{taskId} {
      allow read: if isWorkspaceMember(resource.data.workspace_id);
      allow create: if isWorkspaceMember(request.resource.data.workspace_id);
      allow update, delete: if isWorkspaceMember(resource.data.workspace_id);
    }

    // ========================================================================
    // notes — standalone personal notes (Notes Hub). notes/{noteId}
    // ========================================================================
    // AUTHOR-scoped: a user only ever reads/writes their OWN notes. Reads are gated on author_id
    // alone (a single-field, index-free query: where('author_id','==',uid)); writes ALSO require the
    // note to belong to a workspace the user is a member of, so a note can never be planted into a
    // foreign workspace. visibility is reserved for future workspace-shared notes (not exposed yet) —
    // widen the read rule then, never now. Meeting notes are NOT here (they live on sessions).
    match /notes/{noteId} {
      allow read: if request.auth != null && resource.data.author_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.author_id == request.auth.uid
        && isWorkspaceMember(request.resource.data.workspace_id);
      allow update: if request.auth != null
        && resource.data.author_id == request.auth.uid
        && request.resource.data.author_id == request.auth.uid
        && isWorkspaceMember(resource.data.workspace_id);
      allow delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // ========================================================================
    // note_folders — one-level folders for organizing notes. note_folders/{folderId}
    // ========================================================================
    // Same author-scoped model as notes.
    match /note_folders/{folderId} {
      allow read: if request.auth != null && resource.data.author_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.author_id == request.auth.uid
        && isWorkspaceMember(request.resource.data.workspace_id);
      allow update: if request.auth != null
        && resource.data.author_id == request.auth.uid
        && request.resource.data.author_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // ========================================================================
    // notifications
    // ========================================================================
    // Users can read their own notifications; any workspace member can create/update/delete.
    match /notifications/{notificationId} {
      allow read: if request.auth.uid == resource.data.user_id;
      allow create: if isWorkspaceMember(request.resource.data.workspace_id);
      allow update, delete: if isWorkspaceMember(resource.data.workspace_id);
    }

    // ========================================================================
    // workspace_invites — pending invitations to join a workspace
    // ========================================================================
    // Only the workspace OWNER may create an invite. The role is constrained to admin|member (never
    // owner), the status must start 'pending', and invited_by must be the caller — so a client can
    // never mint an owner invite or forge the inviter. See docs/AUTHENTICATION.md.
    match /workspace_invites/{inviteId} {
      allow create: if request.auth != null
        && isWorkspaceOwner(request.resource.data.workspace_id)
        && request.resource.data.invited_by_user_id == request.auth.uid
        && request.resource.data.role in ['admin', 'member']
        && request.resource.data.status == 'pending';

      // Workspace members see their workspace's invites; the invited person can read their own
      // invite, matched on the authenticated email (so acceptance verifies identity).
      allow read: if request.auth != null
        && (isWorkspaceMember(resource.data.workspace_id)
            || request.auth.token.email.lower() == resource.data.normalized_email);

      // Owner can revoke/expire; the invited email can accept. The invite's workspace_id and role
      // are immutable on update (can't re-target an invite or escalate its role).
      allow update: if request.auth != null
        && request.resource.data.workspace_id == resource.data.workspace_id
        && request.resource.data.role == resource.data.role
        && (isWorkspaceOwner(resource.data.workspace_id)
            || request.auth.token.email.lower() == resource.data.normalized_email);

      allow delete: if isWorkspaceOwner(resource.data.workspace_id);
    }

    // ========================================================================
    // development_tasks + development_taskboard_meta — INTERNAL dev task board (/tasks)
    // ========================================================================
    // The shared build backlog for the Recall developers. Any signed-in user may read/write — this
    // is an internal tool gated by the auth session, NOT customer data, and it is fully separate
    // from the `tasks` collection (customer meeting action items). This does not weaken any existing
    // rule. Uvejs/Lorik is a device-local attribution label, not an identity claim, so it is not
    // (and cannot be) enforced here. See docs/DEVELOPMENT_TASKBOARD.md.
    match /development_tasks/{taskId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /development_taskboard_meta/{docId} {
      allow read, create, update: if request.auth != null;
    }
  }
}
